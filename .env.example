# Copy to .env.local for development, and set the same keys in your hosting provider (e.g. Vercel → Settings → Environment Variables).

# --- Required for launch ---
NEXT_PUBLIC_SITE_URL=https://www.vqbyte.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@vqbyte.com

# Lead delivery: use EITHER a webhook (Zapier/Make/n8n/CRM) OR Resend email, or both.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
RESEND_API_KEY=
LEAD_TO_EMAIL=sales@vqbyte.com
LEAD_FROM_EMAIL="VQBYTE Website <website@vqbyte.com>"

# --- Optional company details (hidden on the site when empty) ---
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=Monday–Friday, 9:00–18:00
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=

# --- Optional SEO / analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
