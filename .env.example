# Only these three settings live in .env. Everything else (contact details, Resend email,
# MongoDB, webhook, Google Analytics) is managed in the admin panel at /admin.

# Your public website address. Used for canonical URLs, the sitemap, social-share links,
# links inside emails, and to block contact-form posts coming from other websites.
# Changing it requires a rebuild (npm run build).
NEXT_PUBLIC_SITE_URL=https://vqbyte.cloud

# First login for /admin. Change the password from the admin panel after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vqbyteadmin
